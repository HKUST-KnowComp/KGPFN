output_dir: /data/gaoyisen/pfn/output

dataset:
  class: JointDataset
  graphs: all
  # --- graphs 选项说明 ---
  # 仅 all（不含 Atlas）：
  #   graphs: all
  # 仅 Atlas small 全部图：
  #   graphs: "Atlas:small"
  # 仅 Atlas one_hop 全部图：
  #   graphs: "Atlas:one_hop"
  # all + Atlas:small + Atlas:one_hop（逗号分隔字符串）：
  #   graphs: "all,Atlas:small,Atlas:one_hop"
  # 或写成 YAML 列表：
  #   graphs:
  #     - all
  #     - "Atlas:small"
  #     - "Atlas:one_hop"
  # 指定单个 Atlas 图（small 第0号）：
  #   graphs: "Atlas:small:0"
  root: /data/gaoyisen/ultrapfn3/kg-datasets2

model:
  class: Ultra
  # 设为 "none" / "null" 可禁用 structure encoder，仅使用 semantic encoder
  # 默认 "ultra" 表示启用 StructureEncoderRelationAware
  structure_encoder_name: ultra
  enhance_structure: True
  structure_score_enhance: False  # 是否使用 ULTRA MLP score 作为额外特征
  seq_chunk_size: 40  # 序列维度分块，避免 [B,S,num_nodes,D] OOM；null 则不分块
  relation_model:
    class: RelNBFNet
    input_dim: 64
    hidden_dims: [64, 64, 64, 64, 64, 64]
    message_func: distmult
    aggregate_func: sum
    short_cut: yes
    layer_norm: yes
  entity_model:
    class: EntityNBFNet
    input_dim: 64
    entity_chunk_size: 64  # 分块计算 entity 表示，避免 OOM；null 则不分块
    hidden_dims: [64, 64, 64, 64, 64, 64]
    message_func: distmult
    aggregate_func: sum
    short_cut: yes
    layer_norm: yes
  semantic_encoder:
    model_name: none # none, all-MiniLM-L12-v2, local path
    dim: 384

task:
  name: MultiGraphPretraining
  num_negative: 256
  strict_negative: yes
  adversarial_temperature: 0.0
  metric: [mr, mrr, hits@1, hits@3, hits@10]
  num_pos: 10
  num_neg: 80
  # loss_type: "bce" (binary cross entropy with adversarial weighting) or "softmax" (softmax + NLL)
  loss_type: softmax
  # label_smoothing: only used when loss_type=softmax; 0.0 = no smoothing
  label_smoothing: 0.0
  context_label_correction: False

optimizer:
  class: AdamW
  lr: 1.0e-4
  weight_decay: 1.0e-6            # none / null：关闭 weight_decay（脚本内转为 0.0）
train:
  # train params
  gpus: {{ gpus }}
  batch_size: 40
  num_epoch: 50
  log_interval: 10
  batch_per_epoch: 40
  valid_eval_step_interval: 80

  # eval params
  fast_test: 50
  eval_chunk_size: 256

  use_accelerate: true

  # log params（不配置 log_file 时默认写入 working_dir/pretrain_pfn.log）
  max_checkpoints: 10  # 最多保留的 step checkpoint 数量（model_best 始终保留）
  checkpoint_dir: ./checkpoints/
  train_structure_encoder: false
  inverse_relation_semantic_mode: text

  # init model paths
  init_model: true
  structure_encoder_path: ./ckpts/ultra_50g.pth
  limix_repo_id: stableai-org/LimiX-16M
  limix_filename: LimiX-16M.ckpt
  limix_cache_dir: ./cache
  limix_config_path: ./config/limix/limix_config.yaml
  kgpfn_checkpoint: null #null ,ckpt path

  # wandb logging
  use_wandb: false  # 设为 false 禁用 wandb
  wandb_api_key: ""  # set locally; do not commit real keys
  wandb_project: pfn-one
